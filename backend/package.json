{
  "name": "@audax/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "test:capture": "node --env-file=../.env --import tsx src/scripts/test-capture.ts",
    "verify:filters": "node --import tsx src/scripts/verify-filters.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@extractus/article-extractor": "^8.0.0",
    "@fastify/cors": "^9.0.1",
    "bullmq": "5.79.1",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "ioredis": "5.10.1",
    "mssql": "^11.0.1",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.0",
    "undici": "^6.19.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
