# ==============================================================================
# Audax Notícias — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------
NODE_ENV=development
# Porta da API do backend (Fastify)
PORT=3333
# Timezone usado pelo cron. Mantenha America/Sao_Paulo para 08:00/18:00 BRT.
TZ=America/Sao_Paulo
# URL pública da interface web (usada no link do resumo do WhatsApp)
WEB_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Em docker-compose, host = "postgres". Local fora do compose, use "localhost".
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://audax:audax@postgres:5432/audax_noticias

# ------------------------------------------------------------------------------
# Redis (fila BullMQ)
# Em docker-compose, host = "redis". Local fora do compose, use "localhost".
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Agendamento (cron)
# Expressões cron para os dois disparos diários (horário definido por TZ).
# Padrão: 08:00 e 18:00. Deixe vazio CRON_ENABLED=false para desligar o cron.
# ------------------------------------------------------------------------------
CRON_ENABLED=true
CRON_MORNING=0 8 * * *
CRON_EVENING=0 18 * * *

# ------------------------------------------------------------------------------
# Janela de recência — só coleta/classifica notícias publicadas nas últimas N
# horas (descarta matérias antigas que as fontes devolvem junto). 0 = desliga.
# ------------------------------------------------------------------------------
COLLECT_MAX_AGE_HOURS=24

# ------------------------------------------------------------------------------
# Fonte de notícias: GNews (https://gnews.io)
# Cliente isolado p/ trocar por NewsData.io depois (ver NewsSource interface).
# >>> PREENCHER: sua API key do GNews <<<
# ------------------------------------------------------------------------------
GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4
GNEWS_COUNTRY=br
GNEWS_LANG=pt
# Termos de busca (separados por vírgula) que alimentam a coleta da API.
GNEWS_QUERIES=Selic,câmbio,inflação,safra,crédito rural,agronegócio,FIDC,inadimplência

# ------------------------------------------------------------------------------
# Fonte de notícias: SerpAPI (engine google_news, https://serpapi.com/search)
# Cliente isolado atrás da interface NewsSource, como GNews.
# >>> PREENCHER: sua API key do SerpAPI <<<
# ------------------------------------------------------------------------------
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_GL=br
SERPAPI_HL=pt-br
# Termos de busca (separados por vírgula) que alimentam a coleta via SerpAPI.
SERPAPI_QUERIES=Selic,câmbio,inflação,safra,crédito rural,agronegócio,FIDC,inadimplência

# ------------------------------------------------------------------------------
# Fontes RSS (agregadas via rss-parser)
# Lista de URLs separadas por vírgula. PLACEHOLDERS — preencha com feeds reais
# de agro e economia (ex.: Valor, Globo Rural, Notícias Agrícolas, etc.).
# ------------------------------------------------------------------------------
RSS_FEEDS=https://exemplo-agro.com.br/feed,https://exemplo-economia.com.br/rss

# ==============================================================================
# Provedor de LLM
# ------------------------------------------------------------------------------
# 'anthropic' = chama o Claude DIRETO (mais simples; só precisa da ANTHROPIC_API_KEY).
# 'litellm'   = usa o gateway LiteLLM externo (audax-ai-gateway).
# ==============================================================================
LLM_PROVIDER=anthropic

# --- Opção A: Anthropic direto (quando LLM_PROVIDER=anthropic) ---
# >>> PREENCHER: sua API key da Anthropic (https://console.anthropic.com) <<<
ANTHROPIC_API_KEY=
# Modelo Claude p/ classificação profunda e resumo. claude-sonnet-4-6 equilibra
# qualidade/custo; claude-opus-4-8 é o mais capaz (e mais caro).
ANTHROPIC_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Funil de filtragem (reduz volume e custo, controla o que chega no CEO)
# ------------------------------------------------------------------------------
# Triagem barata (modelo leve) que pontua os títulos ANTES da classificação cara.
TRIAGE_MODEL=claude-haiku-4-5
TRIAGE_MIN_SCORE=40          # só títulos com score >= isto seguem p/ classificação
TRIAGE_MAX_TO_CLASSIFY=50    # teto de itens enviados ao modelo caro (controla custo)
# Gate do resumo executivo (o que entra no WhatsApp/dashboard do CEO).
SUMMARY_MIN_RELEVANCE=65     # piso de relevância p/ aparecer no resumo
SUMMARY_MAX_ITEMS=7          # máx de notícias por disparo
SEND_ON_EMPTY=false          # dia sem nada >= piso → não dispara (silêncio)

# ------------------------------------------------------------------------------
# Opção B: gateway LiteLLM (quando LLM_PROVIDER=litellm) — EM STANDBY por enquanto.
# Stack EXTERNA "audax-ai-gateway" (LiteLLM + Langfuse + Presidio). Este projeto
# NÃO sobe o LiteLLM; apenas consome. As chaves dos provedores ficam no .env do
# gateway; aqui só o endpoint + uma virtual key.
# ------------------------------------------------------------------------------
# No docker-compose o backend já usa http://host.docker.internal:4000 (fala com
# o LiteLLM que roda na sua máquina). Rodando o backend fora do compose, use
# http://localhost:4000.
LITELLM_BASE_URL=http://localhost:4000
# Virtual key emitida pelo gateway LiteLLM (NÃO é a master key; crie uma chave
# de projeto com budget/limite no LiteLLM e cole aqui).
# >>> PREENCHER: virtual key do gateway <<<
LITELLM_API_KEY=
# ALIAS conforme registrado no config.yaml do gateway (NÃO o ID do provedor).
# Aliases disponíveis no audax-ai-gateway:
#   claude-general | claude-premium | claude-fast | claude-code
#   gpt-general    | gpt-premium    | gpt-fast     | gpt-code
#   gemini-general | gemini-premium | gemini-fast
# Recomendado: claude-general (classificação em lote) ou claude-premium (resumo).
LITELLM_MODEL=claude-general
# Quantas notícias por chamada de classificação (batch).
LLM_BATCH_SIZE=10

# ------------------------------------------------------------------------------
# Auditoria / observabilidade (Langfuse)
# O gateway audax-ai-gateway JÁ envia as chamadas de LLM ao Langfuse via callbacks
# do LiteLLM — então a observabilidade do LLM já está coberta lá. Mantemos também
# uma trilha no nosso banco (llm_audit_logs). Este hook app-level (AuditLogger)
# fica DESLIGADO por padrão; só ligue se quiser enviar traces extras direto daqui.
# ------------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# WhatsApp via Evolution API
# >>> PREENCHER: base URL, instância e API key da sua Evolution <<<
# ------------------------------------------------------------------------------
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=audax
EVOLUTION_API_KEY=
# Destinatários do resumo (JIDs de grupo/contato), separados por vírgula.
# Grupos terminam em "@g.us"; contatos em "@s.whatsapp.net".
# >>> PREENCHER: ex.: 5511999999999@s.whatsapp.net,xxxxx@g.us <<<
EVOLUTION_RECIPIENTS=

# Habilita/desabilita o envio real (false = só persiste, não dispara — útil p/ dev)
WHATSAPP_DISPATCH_ENABLED=true

# ------------------------------------------------------------------------------
# Rota de VIGILÂNCIA (ex.: produtos proibidos pela ANVISA) — só no portal por padrão.
# ------------------------------------------------------------------------------
WATCHLIST_QUERIES=produtos proibidos pela ANVISA,ANVISA proíbe,ANVISA suspende lote,ANVISA interdita,recall ANVISA
WATCHLIST_MAX_AGE_DAYS=30
WATCHLIST_MAX_ITEMS=20
WHATSAPP_INCLUDE_WATCHLIST=false

# ------------------------------------------------------------------------------
# 2º fluxo — MERCADO FIDC/factoring/securitização + regulação (CVM/BACEN/CMN).
# Digest e destinatário próprios. EVOLUTION_RECIPIENTS_FIDC vazio = usa o padrão.
# ------------------------------------------------------------------------------
FIDC_QUERIES=FIDC,fundo de investimento em direitos creditórios,securitizadora,securitização de recebíveis,factoring,antecipação de recebíveis,Resolução CVM 175,Uqbar securitização,mercado de crédito privado,juros futuros Brasil,inadimplência crédito Brasil,Relatório Focus Banco Central,Copom Selic,estatísticas de crédito Banco Central,geopolítica economia global
FIDC_MAX_AGE_DAYS=7
FIDC_MAX_ITEMS=60
FIDC_MAX_ANALYZE=15
EVOLUTION_RECIPIENTS_FIDC=

# ------------------------------------------------------------------------------
# 3º fluxo — boletim de COTAÇÕES de commodities (SOJA/MILHO/CAFÉ/BOI GORDO).
# EVOLUTION_RECIPIENTS_COMMODITIES vazio = usa EVOLUTION_RECIPIENTS.
# ------------------------------------------------------------------------------
EVOLUTION_RECIPIENTS_COMMODITIES=

# ------------------------------------------------------------------------------
# PRODUÇÃO (VPS) — usados pelo docker-compose.prod.yml
# ------------------------------------------------------------------------------
# URL pública da Evolution p/ QR/manager. Na VPS: http://IP-DA-VPS:8080
EVOLUTION_SERVER_URL=http://localhost:8080
# (WEB_APP_URL já definido acima — na VPS use http://IP-DA-VPS)
# Credenciais do Postgres (produção — troque a senha!).
POSTGRES_USER=audax
POSTGRES_PASSWORD=audax
POSTGRES_DB=audax_noticias
